<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Member Portal | Sign In</title>
  <meta name="description" content="Sign in to HCCS Member Portal with Google, Facebook, or Email." />
  <style>
    :root {
      --bg-1: #f6f8fc;
      --bg-2: #eaf0ff;
      --card: #ffffff;
      --text: #1a2433;
      --muted: #607089;
      --brand: #0f5da8;
      --brand-2: #0a4b87;
      --google: #ffffff;
      --facebook: #1877f2;
      --border: #dbe3f0;
      --ring: rgba(15, 93, 168, 0.22);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 15% 20%, #d7e8ff 0%, transparent 32%),
        radial-gradient(circle at 80% 15%, #dce5ff 0%, transparent 35%),
        linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .signin-card {
      width: 100%;
      max-width: 430px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: 0 18px 45px rgba(15, 35, 65, 0.12);
      padding: 28px;
      animation: card-enter 360ms ease-out;
    }

    @keyframes card-enter {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.99);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand) 0%, #3a88d0 100%);
      margin-bottom: 14px;
      display: grid;
      place-items: center;
      color: #fff;
      font-weight: 700;
      letter-spacing: 0.4px;
      font-size: 13px;
    }

    h1 {
      margin: 0;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .subtitle {
      margin: 8px 0 22px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .auth-stack {
      display: grid;
      gap: 12px;
    }

    .auth-btn {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
      text-decoration: none;
    }

    .auth-btn:focus-visible,
    .email-field:focus-visible,
    .email-submit:focus-visible {
      outline: 0;
      box-shadow: 0 0 0 4px var(--ring);
    }

    .auth-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(16, 41, 77, 0.12);
    }

    .btn-google {
      background: var(--google);
      color: #1f2a37;
    }

    .btn-facebook {
      background: var(--facebook);
      color: #fff;
      border-color: #1367d6;
    }

    .divider {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 10px;
      align-items: center;
      margin: 6px 0 2px;
      color: #8a97ab;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .divider::before,
    .divider::after {
      content: "";
      height: 1px;
      background: var(--border);
    }

    .email-form {
      display: grid;
      gap: 10px;
      margin-top: 2px;
    }

    .email-field {
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 0.95rem;
      padding: 11px 12px;
      width: 100%;
    }

    .email-submit {
      border: none;
      border-radius: 10px;
      background: var(--brand);
      color: #fff;
      padding: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 140ms ease, transform 140ms ease;
    }

    .email-submit:hover {
      background: var(--brand-2);
      transform: translateY(-1px);
    }

    .note {
      margin: 14px 0 0;
      color: #7d8ca1;
      font-size: 0.82rem;
      line-height: 1.45;
    }

    @media (max-width: 480px) {
      .signin-card {
        padding: 22px;
        border-radius: 14px;
      }

      h1 {
        font-size: 1.34rem;
      }
    }
  </style>
</head>
<body>
  <main class="signin-card" aria-label="Member Portal Sign In">
    <div class="logo" aria-hidden="true">HCCS</div>
    <h1>Sign in to Member Portal</h1>
    <p class="subtitle">Use Google, Facebook, or your email account.</p>

    <section class="auth-stack" aria-label="Social sign in options">
      <a class="auth-btn btn-google" href="#" aria-label="Sign in with Google">
        <span aria-hidden="true">G</span>
        <span>Sign in with Google</span>
      </a>
      <a class="auth-btn btn-facebook" href="#" aria-label="Sign in with Facebook">
        <span aria-hidden="true">f</span>
        <span>Sign in with Facebook</span>
      </a>
    </section>

    <div class="divider" aria-hidden="true">or</div>

    <form class="email-form" action="#" method="post" aria-label="Sign in with email">
      <input class="email-field" type="email" name="email" placeholder="Email address" required />
      <input class="email-field" type="password" name="password" placeholder="Password" required />
      <button class="email-submit" type="submit">Sign in with Email</button>
    </form>

    <p class="note">Connect these buttons and form to your authentication backend when ready.</p>
  </main>
</body>
</html>
