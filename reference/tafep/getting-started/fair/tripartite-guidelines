<script>
    $(document).ready(function () {
        var isMobile = $(window).width() < 768;

        if (isMobile) {
            initMobView();
        }

        if (!isMobile) {
            initSideSticky();

            if ($('.tafep-reveal-button-group button').length > 0) {
                $('.tafep-reveal-button-group button:first-child').removeClass('color--').addClass('tafep-reveal-button--first tafep-reveal-button--active color--');
            }

            $('.tafep-reveal-button-group button').on('click', function () {
                $('.tafep-reveal-button-group button').removeClass('tafep-reveal-button--active');
                $(this).removeClass('color--').addClass('tafep-reveal-button--active color--');

                var targetContent = "#" + $(this).data('relevant-tab');
                $('.tafep-app-content .vertical-tab-container').addClass('hidden');
                $('.tafep-app-content').children(targetContent).removeClass('hidden');

                var $header = document.querySelector("header:not(.sticky)");
                var headerHeight = ($header == null) ? 0 : $header.offsetHeight;
                var notif = document.querySelector(".tafep-notification-block");
                var notifHeight = (notif === null) ? 0 : notif.offsetHeight;
                setTimeout(function () {
                    scrollTo(0, $(".tafep-app").offset().top - notifHeight - headerHeight);
                }, 1000);

                var $sidebarContainer = $('.sidebar-container');
                if ($sidebarContainer.css('margin-top') !== "80px") {
                    $sidebarContainer.css('margin-top', '80px');
                }
            });
        }

        $('.vtab-btn-dg').prepend('<span class="tafep-glyphs--download fz:m m-r:s"></span>');
        $('.tafep-app-content .vertical-tab-container').addClass('hidden');
        $('.tafep-app-content .vertical-tab-container:first-of-type').removeClass('hidden');

        if (location.hash && $("[data-relevant-tab]").length > 0) {
            $("[data-relevant-tab=" + location.hash.slice(1) + "]").click();
        }

        $('.not-scroll').on('click', function (e) {
            e.preventDefault();
            getLink = $(this).attr('href').slice(1);
            $("[data-relevant-tab=" + getLink + "]").click();
        });
    });

    function initMobView() {

        var $firstTabContentId = "#" + $('.tafep-app-content .vertical-tab-container').first().attr('id');
        var $lastTabContentId = "#" + $('.tafep-app-content .vertical-tab-container').last().attr('id');

        $('.vtab-menu').removeClass('gcol:3').addClass('gcol:12');
        $('.vtab-container').removeClass('sidebar-container').addClass('tafep-dropdown');
        $('.vtab-list').removeClass().addClass('vtab-list tafep-dropdown-menu');;
        $('.vtab-content').removeClass('gcol:8').addClass('gcol:12');
        $('.vtab-btn-dg').removeClass().addClass('tafep-button tafep-button--secondary w:100 mxw:100 m-t:l m-b:m vtab-btn-dg');

        var initialValue = $('.vtab-list button').first().html();
        $('.tafep-dropdown-value').html(initialValue);

        $('.tafep-dropdown-menu button').each(function () {
            $(this).removeClass().addClass('tafep-dropdown-menu__option');
        });

        $('.tafep-dropdown-menu button').on('click', function () {
            var targetContent = "#" + $(this).data('relevant-tab');
            $('.tafep-app-content .vertical-tab-container').addClass('hidden');
            $('.tafep-app-content').children(targetContent).removeClass('hidden');
            $('.tafep-dropdown-menu button:first-of-type').removeClass('hidden');

            if ($firstTabContentId === targetContent) {
                $('.vtab-btn-prev').addClass('hidden');
            }
            else {
                $('.vtab-btn-prev').removeClass('hidden');
            }

            if ($lastTabContentId === targetContent) {
                $('.vtab-btn-next').addClass('hidden');
            }
            else {
                $('.vtab-btn-next').removeClass('hidden');
            }
        });

        $('.vtab-btn-prev').on('click', function () {
            var $activeTab = $(".tafep-app-content .vertical-tab-container").not(".hidden");

            if ($activeTab.length === 1) {
                var targetContent = $activeTab.prev().attr('id');
                if (targetContent !== undefined) {
                    $('.tafep-dropdown-menu button[data-relevant-tab="' + targetContent + '"]').click();
                    scrollTo(0, $(".vtab-content").offset().top);
                }
            }
        });

        $('.vtab-btn-next').on('click', function () {
            var $activeTab = $(".tafep-app-content .vertical-tab-container").not(".hidden");

            if ($activeTab.length === 1) {
                var targetContent = $activeTab.next().attr('id');
                if (targetContent.length !== undefined) {
                    $('.tafep-dropdown-menu button[data-relevant-tab="' + targetContent + '"]').click();
                    scrollTo(0, $(".vtab-content").offset().top);
                }
            }
        });

        $("[data-relevant-tab=" + location.hash.slice(1) + "]").on("click", function () {
            if ($(window).width() < 768) {
                window.scrollTo(0, document.querySelector(".tafep-app-container").offsetTop - document.querySelector(".tafep-header").offsetHeight);
            }
        });
    }

    function initSideSticky() {
        var $stickyNav = document.querySelector(".sidebar-container");

        if (!document.querySelector('body').classList.contains('mob')) {
            var $contentContainer = document.querySelector(".tafep-app-content");
            var offset = 80;
            var heightFromTop = $stickyNav.getBoundingClientRect().top + window.pageYOffset - offset;

            window.onscroll = () => {
                var maxHeightToReach = $contentContainer.offsetHeight + $contentContainer.getBoundingClientRect().top + window.pageYOffset - $stickyNav.offsetHeight;

                if (window.pageYOffset >= heightFromTop && window.pageYOffset <= maxHeightToReach) {
                    var marginTop = window.pageYOffset - heightFromTop;
                    $stickyNav.style.transition = "all 0 cubic-bezier(0.25, 0.46, 0.45, 0.94)";
                    $stickyNav.style.marginTop = marginTop + "px";
                }
            }
        }
    }
</script>




